<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_size_xxl"
        android:paddingEnd="@dimen/padding_size_xxl"
        android:paddingTop="@dimen/padding_size_l"
        android:paddingBottom="@dimen/padding_size_l">

        <TextView
            android:id="@+id/text_profileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="0000000"
            android:textColor="@color/md_grey_900"
            android:textSize="@dimen/font_text_size_m"
            android:layout_marginEnd="@dimen/padding_size_l"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/text_host"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_edit"/>

        <TextView
            android:id="@+id/text_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="0000000"
            android:textColor="@color/md_grey_500"
            android:textSize="@dimen/font_text_size_m"
            android:layout_marginTop="@dimen/padding_size_s"
            app:layout_constraintStart_toStartOf="@+id/text_profileName"
            app:layout_constraintEnd_toEndOf="@+id/text_profileName"
            app:layout_constraintTop_toBottomOf="@+id/text_profileName"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_edit"
            android:layout_width="@dimen/icon_common_size"
            android:layout_height="@dimen/icon_common_size"
            app:srcCompat="@drawable/ic_edit"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="@dimen/padding_size_s"
            android:background="?android:selectableItemBackground"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>