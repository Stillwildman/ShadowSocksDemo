<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layout_nodeSelectorRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_size_xl"
        android:clickable="true"
        android:focusable="true"
        android:background="?android:selectableItemBackground">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_point"
            android:layout_width="@dimen/icon_common_size"
            android:layout_height="@dimen/icon_common_size"
            app:srcCompat="@drawable/ic_point"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_selectNode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_size_xxl"
            android:layout_marginEnd="@dimen/padding_size_s"
            android:text="@string/select_node"
            android:textSize="@dimen/font_text_size_m"
            android:textColor="@color/md_grey_800"
            app:layout_constraintStart_toEndOf="@+id/image_point"
            app:layout_constraintEnd_toStartOf="@+id/image_rightArrow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/text_nodeName"/>

        <TextView
            android:id="@+id/text_nodeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_size_m"
            android:text="@string/select_node"
            android:textSize="@dimen/font_text_size_m"
            android:textColor="@color/md_grey_500"
            app:layout_constraintStart_toStartOf="@+id/text_selectNode"
            app:layout_constraintEnd_toEndOf="@+id/text_selectNode"
            app:layout_constraintTop_toBottomOf="@+id/text_selectNode"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_rightArrow"
            android:layout_width="@dimen/icon_common_size"
            android:layout_height="@dimen/icon_common_size"
            app:srcCompat="@drawable/ic_right_arrow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>